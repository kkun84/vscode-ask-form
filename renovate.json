{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommitsDisabled"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["@playwright/test", "pnpm"],
      "enabled": false
    },
    {
      "matchPackageNames": ["oxlint", "oxfmt"],
      "groupName": "oxc"
    },
    {
      "matchPackageNames": ["typescript", "@effect/tsgo", "effect"],
      "groupName": "TypeScript and Effect"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}

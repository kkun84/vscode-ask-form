        "worker_threads",
        "zlib",
        "node:assert",
        "node:buffer",
        "node:child_process",
        "node:crypto",
        "node:dns",
        "node:events",
        "node:fs",
        "node:http",
        "node:https",
        "node:net",
        "node:os",
        "node:path",
        "node:process",
        "node:stream",
        "node:tls",
        "node:url",
        "node:util",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "ツールの処理は通信手段を知らない",
      "severity": "error"
    }
  ]
}

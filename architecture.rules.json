{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/rule-pack-schema.json",
  "version": 1,
  "name": "architecture",
  "description": "docs/design/architecture.md のうち、外部モジュールへの依存の規則",
  "rules": [
    {
      "id": "ARCH-LAYER-001",
      "kind": "banned-import",
      "files": ["src/core/**"],
      "specifiers": [
        "vscode",
        "assert",
        "buffer",
        "child_process",
        "crypto",
        "dns",
        "events",
        "fs",
        "http",
        "https",
        "net",
        "os",
        "path",
        "process",
        "stream",
        "tls",
        "url",
        "util",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:buffer",
        "node:child_process",
        "node:crypto",
        "node:dns",
        "node:events",
        "node:fs",
        "node:http",
        "node:https",
        "node:net",
        "node:os",
        "node:path",
        "node:process",
        "node:stream",
        "node:tls",
        "node:url",
        "node:util",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "中核は純粋に保つ。VS CodeとNode.jsに依存しない",
      "severity": "error"
    },
    {
      "id": "ARCH-LAYER-002",
      "kind": "banned-import",
      "files": ["src/ui/**"],
      "specifiers": [
        "vscode",
        "effect",
        "assert",
        "buffer",
        "child_process",
        "crypto",
        "dns",
        "events",
        "fs",
        "http",
        "https",
        "net",
        "os",
        "path",
        "process",
        "stream",
        "tls",
        "url",
        "util",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:buffer",
        "node:child_process",
        "node:crypto",
        "node:dns",
        "node:events",
        "node:fs",
        "node:http",
        "node:https",
        "node:net",
        "node:os",
        "node:path",
        "node:process",
        "node:stream",
        "node:tls",
        "node:url",
        "node:util",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "画面はブラウザだけで動き、Effectを含めない",
      "severity": "error"
    },
    {
      "id": "ARCH-LAYER-003",
      "kind": "banned-import",
      "files": ["src/mcp/**"],
      "specifiers": ["vscode"],
      "message": "MCPサーバーはVS Codeを知らない。ports.tsのサービスを使う",
      "severity": "error"
    },
    {
      "id": "ARCH-LAYER-004",
      "kind": "banned-import",
      "files": ["src/extension/web/**", "src/extension/shared/**"],
      "specifiers": [
        "assert",
        "buffer",
        "child_process",
        "crypto",
        "dns",
        "events",
        "fs",
        "http",
        "https",
        "net",
        "os",
        "path",
        "process",
        "stream",
        "tls",
        "url",
        "util",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:buffer",
        "node:child_process",
        "node:crypto",
        "node:dns",
        "node:events",
        "node:fs",
        "node:http",
        "node:https",
        "node:net",
        "node:os",
        "node:path",
        "node:process",
        "node:stream",
        "node:tls",
        "node:url",
        "node:util",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "web版で動くコードはNode.jsを使わない",
      "severity": "error"
    },
    {
      "id": "ARCH-LAYER-006",
      "kind": "banned-import",
      "files": ["src/core/expression.ts", "src/core/form.ts", "src/core/hash.ts", "src/core/messages.ts"],
      "specifiers": ["effect"],
      "ignoreTypeOnly": true,
      "message": "画面が使う中核は実行時にEffectを使わない",
      "severity": "error"
    },
    {
      "id": "ARCH-EFFECT-001",
      "kind": "banned-import",
      "files": ["src/mcp/ports.ts"],
      "specifiers": [
        "assert",
        "buffer",
        "child_process",
        "crypto",
        "dns",
        "events",
        "fs",
        "http",
        "https",
        "net",
        "os",
        "path",
        "process",
        "stream",
        "tls",
        "url",
        "util",
        "worker_threads",
        "zlib",
        "node:assert",
        "node:buffer",
        "node:child_process",
        "node:crypto",
        "node:dns",
        "node:events",
        "node:fs",
        "node:http",
        "node:https",
        "node:net",
        "node:os",
        "node:path",
        "node:process",
        "node:stream",
        "node:tls",
        "node:url",
        "node:util",
        "node:worker_threads",
        "node:zlib"
      ],
      "message": "サービスの定義は実装を知らない",
      "severity": "error"
    },
    {
      "id": "ARCH-EFFECT-002",
      "kind": "banned-import",
      "files": ["src/mcp/server.ts", "src/mcp/pending.ts", "src/mcp/schema.ts"],
      "specifiers": [
        "assert",
        "buffer",
        "child_process",
        "crypto",
        "dns",
        "events",
        "fs",
        "http",
        "https",
        "net",
        "os",
        "path",

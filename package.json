{
  "name": "ask-form",
  "displayName": "Ask Form",
  "version": "0.1.0",
  "private": true,
  "description": "Lets GitHub Copilot ask you through interactive forms in the chat, prefilled with its best guesses.",
  "categories": [
    "AI",
    "Chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkun84/vscode-ask-form"
  },
  "publisher": "kkun84",
  "type": "module",
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "build": "node scripts/build.ts",
    "manifest": "node scripts/manifest.ts",
    "typecheck": "node scripts/typecheck.ts",
    "lint": "oxlint --deny-warnings && oxfmt --check && fallow --fail-on-issues && markdownlint-cli2 && node scripts/no-comments.ts && node scripts/manifest.ts --check && node scripts/traceability.ts",
    "format": "oxfmt",
    "test:unit": "node scripts/timed.ts unit node --test --test-timeout=5000 \"test/unit/**/*.test.ts\"",
    "test:system": "pnpm -s build && node scripts/timed.ts system node --test --test-timeout=5000 \"test/system/**/*.test.ts\"",
    "test:ui": "pnpm -s build && node scripts/timed.ts ui playwright test",
    "budget": "node scripts/budget.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:system && pnpm test:ui",
    "prepare": "lefthook install --reset-hooks-path",
    "test:integration": "pnpm -s build && node scripts/timed.ts integration node --test --test-timeout=10000 \"test/integration/**/*.test.ts\"",
    "test:acceptance": "pnpm -s build && node scripts/timed.ts acceptance node scripts/acceptance.ts",
    "media": "pnpm -s build && node scripts/media.ts && node scripts/pv.ts",
    "traceability": "node scripts/traceability.ts --write",
    "package": "pnpm -s build && cd out/extension && pnpm dlx @vscode/vsce@4.0.0 package --no-dependencies --out ../..",
    "check-env": "node scripts/check-env.ts"
  },
  "dependencies": {
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.0",
    "@types/vscode": "1.110.0",
    "@vscode/test-web": "0.0.81",
    "axe-core": "4.14.0",
    "esbuild": "0.25.10",
    "fallow": "3.36.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "ask-form.mcp",
        "label": "Ask Form"
      }
    ],
    "languageModelTools": [
      {
        "name": "forms_ask_form",
        "toolReferenceName": "askForm",
        "displayName": "Ask with a form",
        "userDescription": "Ask you through an interactive form prefilled with Copilot's guesses.",
        "modelDescription": "Ask the user a question through an interactive form shown in the chat, and wait for the answer. Use it only when the answer materially changes the work and the question has several interdependent values, many fields, or values whose consequences the user should see (use computed for those). For a single simple choice, prefer the built-in askQuestions tool instead. Always prefill every field with your best guess from the workspace and conversation, and explain the source in reason, so the user only fixes what is wrong. Write labels in the user's language. Never ask for secrets or credentials. Do not use it when the user asked you to work autonomously. The result tells you whether the user submitted values, delegated the decision to you, or will answer in chat.",
        "canBeReferencedInPrompt": true,
        "when": "isWeb",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "fields": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "text"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "maxLength": 40,
                        "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "description": "Label shown to the user, in the user's language."
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 120,
                        "description": "Why you guessed the default value, citing the source (file, earlier message). Shown under the field."
                      },
                      "advanced": {
                        "type": "boolean",
                        "description": "Fold this field into the collapsed Details section."
                      },
                      "default": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "placeholder": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "multiline": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "id",
                      "label"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "number"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "maxLength": 40,
                        "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "description": "Label shown to the user, in the user's language."
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 120,
                        "description": "Why you guessed the default value, citing the source (file, earlier message). Shown under the field."
                      },
                      "advanced": {
                        "type": "boolean",
                        "description": "Fold this field into the collapsed Details section."
                      },
                      "default": {
                        "type": "number"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "step": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "prefix": {
                        "type": "string",
                        "maxLength": 8
                      },
                      "suffix": {
                        "type": "string",
                        "maxLength": 8
                      }
                    },
                    "required": [
                      "type",
                      "id",
                      "label",
                      "min",
                      "max"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "choice"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "maxLength": 40,
                        "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "description": "Label shown to the user, in the user's language."
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 120,
                        "description": "Why you guessed the default value, citing the source (file, earlier message). Shown under the field."
                      },
                      "advanced": {
                        "type": "boolean",
                        "description": "Fold this field into the collapsed Details section."
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 60
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 60
                            },
                            "description": {
                              "type": "string",
                              "maxLength": 120
                            }
                          },
                          "required": [
                            "value",
                            "label"
                          ],
                          "additionalProperties": true
                        },
                        "minItems": 2,
                        "maxItems": 12
                      },
                      "default": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "multiple": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "id",
                      "label",
                      "options"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "toggle"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "maxLength": 40,
                        "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "description": "Label shown to the user, in the user's language."
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 120,
                        "description": "Why you guessed the default value, citing the source (file, earlier message). Shown under the field."
                      },
                      "advanced": {
                        "type": "boolean",
                        "description": "Fold this field into the collapsed Details section."
                      },
                      "default": {
                        "type": "boolean"
                      },
                      "note": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "type",
                      "id",
                      "label"
                    ],
                    "additionalProperties": true
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 20
            },
            "computed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "description": "Arithmetic over field ids and earlier computed ids. Operators + - * / % < <= > >= == != && || ! ?: and min max abs floor ceil round."
                  },
                  "prefix": {
                    "type": "string",
                    "maxLength": 8
                  },
                  "suffix": {
                    "type": "string",
                    "maxLength": 8
                  },
                  "decimals": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "primary": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "expression"
                ],
                "additionalProperties": true
              },
              "maxItems": 8
            },
            "submitLabel": {
              "type": "string",
              "maxLength": 20
            }
          },
          "required": [
            "title",
            "fields"
          ],
          "additionalProperties": true
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguageModelTool:forms_ask_form",
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "node": ">=22.18.0",
    "vscode": "^1.110.0"
  },
  "packageManager": "pnpm@12.9.0"
}

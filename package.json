          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Aim for 80 characters or fewer."
            },
            "description": {
              "type": "string",
              "maxLength": 600,
              "description": "Aim for 300 characters or fewer."
            },
            "fields": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "text"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "maxLength": 40,
                        "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "description": "Label shown to the user, in the user's language. Aim for 60 characters or fewer."
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 240,
                        "description": "What this question asks or what the value is used for, independent of your recommendation. Shown under the label. Aim for 120 characters or fewer."
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 120,
                        "description": "One sentence on why you recommend the default for this situation, citing what you found. Shown with the recommended value. Only allowed together with default. Aim for 60 characters or fewer."
                      },
                      "reasonDetails": {
                        "type": "string",
                        "maxLength": 600,
                        "description": "More on why you recommend the default, in full sentences. Can be hidden by the user. Only allowed together with default. Aim for 300 characters or fewer."
                      },
                      "advanced": {
                        "type": "boolean",
                        "description": "Fold this field into the collapsed Details section."
                      },
                      "default": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "placeholder": {
                        "type": "string",
                        "maxLength": 160,
                        "description": "Aim for 80 characters or fewer."
                      },
                      "multiline": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "id",
                      "label"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {

                        "type": "string",
                        "maxLength": 40,
                        "description": "Unique identifier: letters, digits and underscore, starting with a letter or underscore; true and false are reserved."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60,
                        "description": "Label shown to the user, in the user's language."
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 60,
                        "description": "One sentence on why the default is the best fit for this situation, citing what you found. Always shown with the recommended value."
                      },
                      "reasonDetails": {
                        "type": "string",
                        "maxLength": 300,
                        "description": "More on why the default fits, in full sentences. Can be hidden by the user."
                      },
                      "advanced": {
                        "type": "boolean",
                        "description": "Fold this field into the collapsed Details section."
                      },
                      "default": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "placeholder": {
